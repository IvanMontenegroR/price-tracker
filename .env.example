# ── El sitio (build estático para GitHub Pages) ──────────────────────────────
# Estas tres viajan al navegador. La clave anon es pública por diseño: lo que
# protege los datos es la RLS, no esconderla.
NEXT_PUBLIC_SUPABASE_URL=https://ofekkczobrxhjoyggtmc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Solo en Pages, donde el sitio cuelga de /price-tracker/. En local, vacío.
NEXT_PUBLIC_BASE_PATH=

# ── La edge function del recolector (supabase secrets set …) ─────────────────
# SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY se las inyecta Supabase sola.
# El secreto que manda pg_cron en la cabecera; se lee de Vault con:
#   select decrypted_secret from vault.decrypted_secrets where name='cron_secreto';
CRON_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:vos@tudominio.com
RESEND_API_KEY=
EMAIL_DESDE="Precio puesto <alertas@tudominio.com>"

# eBay: developer.ebay.com → crear una app de producción. Son gratis y no
# piden ventas previas. Es la fuente principal.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE=EBAY_US

# Amazon: sin implementar. Su contrato exige la Product Advertising API, y esa
# API exige cuenta de Associates aprobada con ventas calificadas.
# PAAPI_ACCESS_KEY=
# PAAPI_SECRET_KEY=
# PAAPI_PARTNER_TAG=

# Best Buy: la tienda está apagada. Si la prendo, va la clave acá.
# BESTBUY_API_KEY=
# Techo de peticiones por día. Si se agota, los fríos dejan de chequearse.
PRESUPUESTO_DIARIO=2000
MAX_POR_TICK=40

# ── Los scripts de terminal ─────────────────────────────────────────────────
# scripts/sembrar.ts y scripts/recolectar.ts necesitan además:
SUPABASE_SERVICE_ROLE_KEY=
