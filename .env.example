# ── Supabase ────────────────────────────────────────────────────────────────
# El esquema del tracker vive en el schema "tracker" de este proyecto.
NEXT_PUBLIC_SUPABASE_URL=https://ofekkczobrxhjoyggtmc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Nunca en el navegador: salta RLS.
SUPABASE_SERVICE_ROLE_KEY=

# ── Cron ────────────────────────────────────────────────────────────────────
# Vercel manda Authorization: Bearer $CRON_SECRET a las rutas de cron.
CRON_SECRET=
# Techo de peticiones por día. Si se agota, los fríos dejan de chequearse.
PRESUPUESTO_DIARIO=2000
# Techo por tick, para no hacer 200 pedidos en un mismo minuto.
MAX_POR_TICK=40

# ── Avisos ──────────────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_DESDE="Precio puesto <alertas@tudominio.com>"

# npm run vapid las genera.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:vos@tudominio.com

# ── Tiendas ─────────────────────────────────────────────────────────────────
# Best Buy: clave gratis en developer.bestbuy.com
BESTBUY_API_KEY=
